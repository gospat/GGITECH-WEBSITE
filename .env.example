# --- Outbound email (Resend) ------------------------------------------------
# Server-only. The website sends through the Resend HTTPS API; there is no SMTP
# transport. None of these may be prefixed with NEXT_PUBLIC_ — RESEND_API_KEY
# in particular would be inlined into the browser bundle and is a live secret.
#
# Leave them unset in local development and CI. Nothing is read at build time,
# so a build never needs real credentials; an unconfigured deployment still
# serves every page and fails closed with a clear server-side error only when
# someone actually submits a form.

# Resend API key, e.g. re_xxxxxxxx. Create it in the Resend dashboard after the
# sending domain is verified.
RESEND_API_KEY=

# Verified sender identity. The address must be on a domain verified in Resend,
# or on the Resend-provided onboarding domain. The display name is optional.
RESEND_FROM_EMAIL=GGITECH <notifications@ggitech.dev>

# Where enquiry notifications are delivered. Never supplied by the public form.
# Until a mailbox on ggitech.dev exists, point this at a real address the
# business already monitors — an @ggitech.dev address will not receive mail just
# because Resend can send from the domain.
CONTACT_NOTIFICATION_EMAIL=

# Reply-To on the customer acknowledgement. Defaults to
# CONTACT_NOTIFICATION_EMAIL, which is correct when that address is monitored.
# Set it only to route acknowledgement replies somewhere else. Never the
# customer's own address: replies must reach the team.
CONTACT_REPLY_TO_EMAIL=

# Send an automatic acknowledgement to the customer once the internal
# notification has been accepted. Set to false to notify the team only.
CONTACT_AUTO_REPLY_ENABLED=true

# Public canonical origin. Drives every canonical tag, sitemap entry, Open Graph
# URL and JSON-LD url. Must be the production domain with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://ggitech.dev

# --- Published contact address (optional) -----------------------------------
# The address the website prints in the footer, on /contact, in error messages,
# in structured data, and offers as the fallback when a form cannot send.
#
# Leave it blank until a real mailbox exists, is business-owned, and has been
# confirmed to receive mail. A published address with no mailbox behind it is
# worse than none: a mailto link that opens a dead destination looks like a
# working route, so the customer writes in and never hears back.
#
# This is public by definition, which is why it is NEXT_PUBLIC_ — it is not a
# secret and it is not a notification destination. Where notifications are
# delivered and what acknowledgements reply to stay server-side in
# CONTACT_NOTIFICATION_EMAIL and CONTACT_REPLY_TO_EMAIL.
#
# While it is blank, every consumer renders the contact form instead, and the
# failure messages a form shows name no address at all. A blank or malformed
# value is treated as "not configured", so a typo degrades the site rather than
# publishing a broken address.
#
# Because it is NEXT_PUBLIC_, changing it requires a rebuild, not just a
# restart — it is substituted at build time.
NEXT_PUBLIC_CONTACT_EMAIL=

NEXT_PUBLIC_ENABLE_3D=false

# Optional: move the API rate-limit counters into Redis so the limit holds
# across server instances and survives a deploy. Leave both blank to use the
# built-in in-process counters (bounded, but per-instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many reverse proxies sit between the internet and this app and are
# trusted to append to x-forwarded-for. Set to 0 when the app is exposed
# directly, which makes client IPs unverifiable and disables IP-based limiting.
# Rate limiting keys off the resolved client IP, so this value is also what
# stops a forged X-Forwarded-For from handing a caller a fresh rate-limit
# bucket. Keep it at 1 while nginx is the only proxy in front of the app.
TRUSTED_PROXY_HOPS=1
