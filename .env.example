SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
OFFICIAL_BRIEF_EMAIL=

# Public canonical origin. Drives every canonical tag, sitemap entry, Open Graph
# URL and JSON-LD url. Must be the production domain with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://ggitech.dev

NEXT_PUBLIC_ENABLE_3D=false

# Optional: move the API rate-limit counters into Redis so the limit holds
# across server instances and survives a deploy. Leave both blank to use the
# built-in in-process counters (bounded, but per-instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many reverse proxies sit between the internet and this app and are
# trusted to append to x-forwarded-for. Set to 0 when the app is exposed
# directly, which makes client IPs unverifiable and disables IP-based limiting.
TRUSTED_PROXY_HOPS=1
